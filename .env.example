# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Database Configuration (SQLite local file)
DATABASE_URL=sqlite://stock_exchange.db

# Upstash Redis Configuration (Replace placeholder values with your Upstash credentials)
REDIS_URL=rediss://default:your-upstash-password@your-endpoint.upstash.io:6379

# Logging Level
LOG_LEVEL=info
